      "type": "method",
      "importance": 2,
      "label": "Positional encoding",
      "label_en": "Positional encoding",
      "label_zh": "位置编码",
      "detail": "Sinusoidal encodings are added because the attention-only model has no recurrence or convolution to represent token order.",
      "detail_en": "Sinusoidal encodings are added because the attention-only model has no recurrence or convolution to represent token order.",
      "detail_zh": "由于没有循环或卷积，模型加入正弦位置编码来表示词元顺序。",
      "section": "Position",
